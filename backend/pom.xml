<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.1</version>
        <relativePath/>
    </parent>

    <groupId>com.timetracker</groupId>
    <artifactId>time-tracker</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>TimeTracker</name>
    <description>Time Tracking Application Backend</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- ── Mutation testing (PITest) ── -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>1.17.1</version>
                <dependencies>
                    <!-- JUnit 5 support for PITest -->
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>1.2.1</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <!-- Mutate only service classes — they contain the business logic -->
                    <targetClasses>
                        <param>com.timetracker.service.*</param>
                    </targetClasses>
                    <!-- Run only the fast service unit tests (Mockito-based, no Spring context) -->
                    <targetTests>
                        <param>com.timetracker.service.*</param>
                    </targetTests>
                    <!-- Standard DEFAULTS mutator set -->
                    <mutators>
                        <mutator>DEFAULTS</mutator>
                    </mutators>
                    <!-- Enforce 80% test strength: % of COVERED mutations killed by unit tests -->
                    <testStrengthThreshold>80</testStrengthThreshold>
                    <!-- Consistent output location for CI -->
                    <timestampedReports>false</timestampedReports>
                    <outputFormats>
                        <outputFormat>HTML</outputFormat>
                        <outputFormat>XML</outputFormat>
                    </outputFormats>
                    <!-- Fail the build if coverage threshold not met -->
                    <failWhenNoMutations>true</failWhenNoMutations>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <configuration>
                    <excludes>
                        <!-- Exclude Spring Boot entry point and config classes with no testable logic -->
                        <exclude>com/timetracker/TimeTrackerApplication.class</exclude>
                        <exclude>com/timetracker/config/**</exclude>
                        <exclude>com/timetracker/entity/**</exclude>
                        <exclude>com/timetracker/repository/**</exclude>
                        <exclude>com/timetracker/dto/**</exclude>
                        <exclude>com/timetracker/exception/TemplateNotFoundException.class</exclude>
                        <exclude>com/timetracker/exception/InvalidTimezoneException.class</exclude>
                        <exclude>com/timetracker/exception/UserNotFoundException.class</exclude>
                        <exclude>com/timetracker/exception/ProjectNotFoundException.class</exclude>
                        <exclude>com/timetracker/exception/TaskNotFoundException.class</exclude>
                        <exclude>com/timetracker/exception/TimerAlreadyRunningException.class</exclude>
                        <exclude>com/timetracker/exception/NoActiveTimerException.class</exclude>
                        <exclude>com/timetracker/exception/BudgetHoursException.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
